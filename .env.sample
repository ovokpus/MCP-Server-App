# Copy this file to .env and replace the placeholders with real keys.
# Never commit .env. The sample values are not credentials.

# REQUIRED for the LangGraph agent (open-ended chat).
# Leave the placeholder in place to use local tool mode, which can roll dice,
# build quote cards, and call the other MCP tools without a model.
OPENAI_API_KEY=your_openai_api_key_here

# REQUIRED for live web_search. Without it, that tool explains that it is unavailable.
TAVILY_API_KEY=your_tavily_api_key_here

# OPTIONAL: Unsplash images for social posts and slide art.
# Without it, those tools fall back to Lorem Picsum.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# OPTIONAL: GitHub token for private repositories and higher rate limits.
# Create one at https://github.com/settings/tokens
# Public repositories work with no token. Placeholder values are ignored.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# OPTIONAL: LangSmith tracing for the agent.
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=mcp-server-app

# Chat API
# auto: LangGraph when OPENAI_API_KEY is real, otherwise local tool routing
# local: always run tools without a model
# openai: require a real OpenAI key (chat returns 503 until one is set)
AGENT_MODE=auto
OPENAI_MODEL=gpt-4o-mini
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed to call the API directly.
# The Next.js UI proxies through /backend, so it does not need CORS.
CORS_ORIGINS=http://localhost:3000

# How the API launches the MCP server over stdio.
# Leave these unset on a machine with uv (the default is `uv run run_server.py`).
# Docker Compose sets MCP_COMMAND=python and MCP_ARGS=run_server.py.
# MCP_COMMAND=python
# MCP_ARGS=run_server.py

# Where the Next.js server proxies /backend/* requests.
# Local `npm run dev`: http://127.0.0.1:8000
# Docker Compose sets this to http://api:8000 for the web container.
API_INTERNAL_URL=http://127.0.0.1:8000
